{
  "id": "tool-7",
  "name": "$text:.name",
  "note": "$text:.note",
  "revision": 1,
  "executionId": "00000000-0000-4000-8000-000000000003",
  "enabled": true,
  "description": "$text:.description",
  "parameters": [
    {
      "name": "language",
      "type": "string",
      "required": true,
      "description": "$text:.parameters.language",
      "variableId": "var-language"
    },
    {
      "name": "appId",
      "type": "integer",
      "required": false,
      "description": "$text:.parameters.appId",
      "variableId": "var-appId"
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "description": "$text:.parameters.id",
      "variableId": "var-id"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "$text:.parameters.title",
      "variableId": "var-title"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "$text:.parameters.description",
      "variableId": "var-description"
    },
    {
      "name": "revision",
      "type": "integer",
      "required": false,
      "description": "$text:.parameters.revision",
      "variableId": "var-revision"
    },
    {
      "name": "translatedTitle",
      "type": "string",
      "required": false,
      "description": "$text:.parameters.translatedTitle",
      "variableId": "var-translatedTitle"
    },
    {
      "name": "translatedDescription",
      "type": "string",
      "required": false,
      "description": "$text:.parameters.translatedDescription",
      "variableId": "var-translatedDescription"
    },
    {
      "name": "changes",
      "type": "array",
      "required": false,
      "description": "$text:.parameters.changes",
      "variableId": "var-changes"
    }
  ],
  "variables": [
    {
      "id": "var-appId",
      "name": "appId",
      "type": "number"
    },
    {
      "id": "var-id",
      "name": "id",
      "type": "text"
    },
    {
      "id": "var-title",
      "name": "title",
      "type": "text"
    },
    {
      "id": "var-description",
      "name": "description",
      "type": "text"
    },
    {
      "id": "var-revision",
      "name": "revision",
      "type": "number"
    },
    {
      "id": "var-translatedTitle",
      "name": "translatedTitle",
      "type": "text"
    },
    {
      "id": "var-translatedDescription",
      "name": "translatedDescription",
      "type": "text"
    },
    {
      "id": "var-language",
      "name": "language",
      "type": "text"
    },
    {
      "id": "var-changes",
      "name": "changes",
      "type": "list"
    },
    {
      "id": "var-items",
      "name": "$text:.variables.items",
      "type": "list"
    },
    {
      "id": "var-item",
      "name": "$text:.variables.item",
      "type": "object"
    },
    {
      "id": "var-index",
      "name": "$text:.variables.index",
      "type": "number"
    },
    {
      "id": "var-error",
      "name": "$text:.variables.error",
      "type": "object"
    },
    {
      "id": "var-prepared",
      "name": "$text:.variables.prepared",
      "type": "object"
    }
  ],
  "steps": [
    {
      "id": "step-validate",
      "kind": "if",
      "branches": [
        {
          "condition": {
            "op": "isFalse",
            "left": {
              "expression": [
                "((rows, language) => /^[a-z][a-z0-9_-]{0,40}$/i.test(language) && rows.length > 0 && rows.every(row => row && (id => Number.isInteger(id) && id >= 1 && id <= 4294967295)(row.appId) && Array.isArray(row.translations) && row.translations.length > 0 && row.translations.every(t => t && typeof t.id === 'string' && t.id.trim() && typeof t.title === 'string' && typeof t.description === 'string' && Number.isSafeInteger(t.revision) && t.revision >= 0 && typeof t.translatedTitle === 'string' && t.translatedTitle.trim() && typeof t.translatedDescription === 'string')))(",
                {
                  "source": "variable",
                  "id": "var-changes",
                  "path": []
                },
                ",",
                {
                  "source": "variable",
                  "id": "var-language",
                  "path": []
                },
                ")"
              ]
            }
          },
          "steps": [
            {
              "id": "step-invalid",
              "kind": "action",
              "action": "raise",
              "value": {
                "literal": {
                  "code": "CHAT_TOOL_INVALID",
                  "message": "$text:.error.badTranslation"
                }
              }
            }
          ]
        }
      ],
      "otherwise": null
    },
    {
      "id": "step-items",
      "kind": "action",
      "action": "list",
      "value": {
        "literal": []
      },
      "output": "var-items"
    },
    {
      "id": "step-loop",
      "kind": "foreach",
      "value": {
        "expression": [
          "((changes) => { const games = new Map(); for(const {appId,translations} of changes) { const entries = games.get(appId) ?? new Map(); for (const entry of translations) { const {id,title,description,revision,translatedTitle,translatedDescription} = entry; const next={id,title,description,revision,translatedTitle,translatedDescription}; if (entries.has(id) && JSON.stringify(entries.get(id)) !== JSON.stringify(next)) throw new Error('Conflicting translations for the same achievement'); entries.set(id,next); } games.set(appId,entries); } return Array.from(games,([appId, entries]) => ({appId, translations:[...entries.values()]})); })(",
          {
            "source": "variable",
            "id": "var-changes",
            "path": []
          },
          ")"
        ]
      },
      "item": "var-item",
      "index": "var-index",
      "body": [
        {
          "id": "step-write",
          "kind": "try",
          "error": "var-error",
          "body": [
            {
              "id": "step-steam",
              "kind": "action",
              "action": "steam-save-translations",
              "game": {
                "source": "variable",
                "id": "var-item",
                "path": [
                  "appId"
                ]
              },
              "value": {
                "source": "variable",
                "id": "var-item",
                "path": [
                  "translations"
                ]
              },
              "language": {
                "source": "variable",
                "id": "var-language",
                "path": []
              },
              "origin": {
                "literal": "ai"
              },
              "output": "var-prepared"
            },
            {
              "id": "step-result-staged",
              "kind": "action",
              "action": "append",
              "value": {
                "source": "variable",
                "id": "var-items",
                "path": []
              },
              "item": {
                "expression": [
                  "({appId:",
                  {
                    "source": "variable",
                    "id": "var-item",
                    "path": [
                      "appId"
                    ]
                  },
                  ",status:'proposed'})"
                ]
              },
              "output": "var-items"
            }
          ],
          "catch": [
            {
              "id": "step-catch",
              "kind": "if",
              "branches": [
                {
                  "condition": {
                    "op": "isTrue",
                    "left": {
                      "expression": [
                        "['ACTION_NOT_WRITTEN','ACTION_INPUT_INVALID','ACTION_WRITE_CONFLICT','ACTION_SOURCE_CHANGED','STEAM_ACHIEVEMENTS_UNAVAILABLE','ACHIEVEMENT_VALUE_INVALID'].includes(",
                        {
                          "source": "variable",
                          "id": "var-error",
                          "path": [
                            "code"
                          ]
                        },
                        ")"
                      ]
                    }
                  },
                  "steps": [
                    {
                      "id": "step-result-failed",
                      "kind": "action",
                      "action": "append",
                      "value": {
                        "source": "variable",
                        "id": "var-items",
                        "path": []
                      },
                      "item": {
                        "expression": [
                          "({appId:",
                          {
                            "source": "variable",
                            "id": "var-item",
                            "path": [
                              "appId"
                            ]
                          },
                          ",status:'failed',code:",
                          {
                            "source": "variable",
                            "id": "var-error",
                            "path": [
                              "code"
                            ]
                          },
                          ",reason:",
                          {
                            "source": "variable",
                            "id": "var-error",
                            "path": [
                              "message"
                            ]
                          },
                          "})"
                        ]
                      },
                      "output": "var-items"
                    }
                  ]
                }
              ],
              "otherwise": [
                {
                  "id": "step-rethrow",
                  "kind": "action",
                  "action": "raise",
                  "value": {
                    "source": "variable",
                    "id": "var-error",
                    "path": []
                  }
                }
              ]
            }
          ],
          "finally": null
        }
      ]
    },
    {
      "id": "step-return",
      "kind": "action",
      "action": "tool-return",
      "value": {
        "expression": [
          "((items) => ({items, changed:0, skipped:0, failed:items.filter(item => item.status === 'failed').length, ...(items.some(item => item.status === 'proposed') ? {confirmationRequired:true} : {})}))(",
          {
            "source": "variable",
            "id": "var-items",
            "path": []
          },
          ")"
        ]
      }
    }
  ],
  "providerInputVersion": 1
}
