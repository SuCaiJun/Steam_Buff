      "output": "var-args"
    },
    {
      "id": "step-validate",
      "kind": "if",
      "branches": [
        {
          "condition": {
            "op": "isFalse",
            "left": {
              "expression": [
                "((a) => a.changes !== undefined ? a.changes.length > 0 && a.changes.every(row => row && (id => Number.isInteger(id) && id >= 1 && id <= 4294967295)(row.appId) && Array.isArray(row.collectionIds) && row.collectionIds.length > 0 && row.collectionIds.every(id => typeof id === 'string' && id.trim())) : a.appIds?.length > 0 && a.appIds.every((id => Number.isInteger(id) && id >= 1 && id <= 4294967295)) && !!a.collectionName?.trim())(",
                {
                  "source": "variable",
                  "id": "var-args",
                  "path": []
                },
                ")"
              ]
            }
          },
          "steps": [
            {
              "id": "step-invalid",
              "kind": "action",
              "action": "raise",
              "value": {
                "literal": {
                  "code": "CHAT_TOOL_INVALID",
                  "message": "$text:.error.badCollection"
                }
              }
            }
          ]
        }
      ],
      "otherwise": null
    },
    {
      "id": "step-groups",
      "kind": "action",
      "action": "steam-collections",
      "output": "var-groups"
    },
    {
      "id": "step-prepare",
      "kind": "action",
      "action": "list",
      "value": {
        "expression": [
          "((a,groups) => { if (a.changes) { const ids = new Map(); for (const row of a.changes) { const list = ids.get(row.appId) ?? new Set(); for (const id of row.collectionIds) list.add(id.trim()); ids.set(row.appId,list); } return Array.from(ids, ([appId, list]) => ({appId, collectionIds:[...list]})); } const name = a.collectionName.trim(); const writable = groups.filter(group => group.writable); const matches = writable.filter(group => group.name === name); return matches.length === 1 ? Array.from(new Set(a.appIds),appId => ({appId,collectionIds:[matches[0].id]})) : []; })(",
          {
            "source": "variable",
            "id": "var-args",
            "path": []
          },
          ",",
          {
            "source": "variable",
            "id": "var-groups",
            "path": []
          },
          ")"
        ]
      },
      "output": "var-rows"
    },
    {
      "id": "step-match",
      "kind": "if",
      "branches": [
        {
          "condition": {
            "op": "empty",
            "left": {
              "source": "variable",
              "id": "var-rows",
              "path": []
            }
          },
          "steps": [
            {
              "id": "step-group-missing",
              "kind": "action",
              "action": "raise",
