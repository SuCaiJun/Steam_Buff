              "output": "var-prepared"
            },
            {
              "id": "step-result-staged",
              "kind": "action",
              "action": "append",
              "value": {
                "source": "variable",
                "id": "var-items",
                "path": []
              },
              "item": {
                "expression": [
                  "({appId:",
                  {
                    "source": "variable",
                    "id": "var-item",
                    "path": [
                      "appId"
                    ]
                  },
                  ",status:'proposed'})"
                ]
              },
              "output": "var-items"
            }
          ],
          "catch": [
            {
              "id": "step-catch",
              "kind": "if",
              "branches": [
                {
                  "condition": {
                    "op": "isTrue",
                    "left": {
                      "expression": [
                        "['ACTION_NOT_WRITTEN','ACTION_INPUT_INVALID','ACTION_WRITE_CONFLICT','ACTION_SOURCE_CHANGED','STEAM_ACHIEVEMENTS_UNAVAILABLE','ACHIEVEMENT_VALUE_INVALID'].includes(",
                        {
