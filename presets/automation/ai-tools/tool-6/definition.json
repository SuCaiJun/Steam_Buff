    {
      "id": "step-loop",
      "kind": "foreach",
      "value": {
        "source": "variable",
        "id": "var-rows",
        "path": []
      },
      "item": "var-item",
      "index": "var-index",
      "body": [
        {
          "id": "step-write",
          "kind": "try",
          "error": "var-error",
          "body": [
            {
              "id": "step-steam",
              "kind": "action",
              "action": "steam-add-collections",
              "game": {
                "source": "variable",
                "id": "var-item",
                "path": [
                  "appId"
                ]
              },
              "value": {
                "source": "variable",
                "id": "var-item",
                "path": [
                  "collectionIds"
                ]
