{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.11.27",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "author": "顾青离",
  "homepage_url": "https://www.sucaijun.com/25.html",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon.png"
    }
  },
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://steamloopback.host/*",
    "https://*.steampowered.com/*",
    "https://steampowered.com/*",
    "https://steamcommunity.com/*",
    "https://*.steamcommunity.com/*",
    "https://api.steampowered.com/*",
    "https://api.augmentedsteam.com/*",
    "https://steampy.com/*",
    "https://www.sucaijun.com/*",
    "https://api.sucaijun.com/*",
    "https://aligueler.com/*",
    "https://steam-buff.ai.sucaijun.com/*"
  ],
  "background": {
    "service_worker": "extension/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ai/config.js",
        "shared/config.js",
        "shared/i18n.js",
        "shared/page-context.js",
        "shared/runtime/kernel.js",
        "shared/logger-factory.js",
        "translate/boot.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "https://steamloopback.host/*"
      ]
    },
    {
      "matches": [
        "https://*.steampowered.com/*",
        "https://steampowered.com/*"
      ],
      "js": [
        "shared/config.js",
        "extension/runtime/injector.js",
        "extension/runtime/logger.js",
        "shared/logger-factory.js",
        "shared/error-boundary.js",
        "shared/page-context.js",
        "shared/runtime/kernel.js",
        "shared/runtime/message-bus.js",
        "shared/settings-bus.js",
        "extension/content.js"
      ],
      "run_at": "document_end",
      "exclude_matches": [
        "https://steamloopback.host/*"
      ]
    },
    {
      "matches": [
        "https://steamloopback.host/*"
      ],
      "js": [
        "extension/runtime/steamloopback-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://steamcommunity.com/*",
        "https://*.steamcommunity.com/*"
      ],
      "js": [
        "extension/runtime/injector.js",
        "extension/runtime/logger.js",
        "shared/logger-factory.js",
        "shared/config.js",
        "shared/error-boundary.js",
        "shared/i18n.js",
        "shared/performance-monitor.js",
        "shared/page-context.js",
        "shared/settings-bus.js",
        "shared/runtime/message-bus.js",
        "extension/content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "shared/styles/theme.js",
        "shared/logger-factory.js",
        "shared/error-boundary.js",
        "shared/errors.js",
        "shared/utils/dom.js",
        "shared/utils/format.js",
        "shared/observer-utils.js",
        "store/features/age-gate/age-gate-skip.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://steamcommunity.com/app/*/reviews*"
      ],
      "js": [
        "shared/observer-utils.js",
        "extension/runtime/logger.js",
        "shared/logger-factory.js",
        "shared/config.js",
        "shared/error-boundary.js",
        "shared/i18n.js",
        "store/features/review/review-filter-core.js",
        "store/features/review/review-filter.js",
        "store/features/review/review-filter-community.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://checkout.steampowered.com/*"
      ],
      "js": [
        "shared/styles/theme.js",
        "shared/utils/dom.js",
        "shared/styles/components.js",
        "shared/scheduler.js",
        "extension/runtime/logger.js",
        "shared/logger-factory.js",
        "shared/runtime/message-bus.js",
        "shared/config.js",
        "shared/error-boundary.js",
        "shared/i18n.js",
        "store/runtime/styles.js",
        "store/features/cart/cart-select-checkout.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/config.js",
        "shared/i18n.js",
        "shared/performance-monitor.js",
        "shared/utils/dom.js",
        "shared/scheduler.js",
        "shared/observer-utils.js",
        "shared/data-index.js",
        "shared/batch-queue.js",
        "shared/virtual-list.js",
        "shared/page-context.js",
        "shared/runtime/kernel.js",
        "_locales/*/messages.json",
        "extension/runtime/logger.js",
        "shared/logger-factory.js",
        "steam/shared/constants.js",
        "shared/error-boundary.js",
        "shared/styles/theme.js",
        "shared/utils/dom.js",
        "shared/styles/components.js",
        "steam/runtime/paths.js",
        "steam/runtime/steam-context.js",
        "steam/runtime/cleanup-stale.js",
        "steam/runtime/styles.js",
        "steam/runtime/feature-registry.js",
        "steam/features/*.js",
        "steam/features/*/*.js",
        "steam/main.js",
        "vendor/fflate/*.js",
        "vendor/pinyin-pro/*.js",
        "images/tip.svg",
        "images/translate.svg"
      ],
      "matches": [
        "https://steamloopback.host/*"
      ]
    },
    {
      "resources": [
        "images/*",
        "store/page/*.js",
        "vendor/SmallFork/purchase-history-classifier.js",
        "_locales/*/messages.json"
      ],
      "matches": [
        "https://store.steampowered.com/*"
      ]
    },
    {
      "resources": [
        "shared/config.js",
        "shared/i18n.js",
        "shared/performance-monitor.js",
        "shared/styles/theme.js",
        "shared/utils/dom.js",
        "shared/styles/components.js",
        "shared/observer-utils.js",
        "shared/data-index.js",
        "shared/batch-queue.js",
        "shared/virtual-list.js",
        "shared/page-context.js",
        "shared/runtime/kernel.js",
        "_locales/*/messages.json",
        "shared/logger-factory.js",
        "shared/error-boundary.js",
        "community/runtime/*.js",
        "extension/runtime/logger.js",
        "community/domain/*.js",
        "community/ui/*.js",
        "community/features/*/*.js",
        "community/main.js",
        "store/page/review-filter-layout.js"
      ],
      "matches": [
        "https://steamcommunity.com/*",
        "https://*.steamcommunity.com/*"
      ]
    },
    {
      "resources": [
        "images/trans.svg",
        "images/close.svg",
        "_locales/*/messages.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "images/icon.png",
        "images/Settings.svg",
        "images/TOP.svg",
        "images/commentFilter.svg",
        "images/tip.svg"
      ],
      "matches": [
        "https://*.steampowered.com/*",
        "https://steampowered.com/*",
        "https://*.steamcommunity.com/*",
        "https://steamcommunity.com/*"
      ]
    }
  ]
}
